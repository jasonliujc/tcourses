# Copy to backend/.env to override startup defaults.
# Everything a user normally changes (Canvas connection, sync scope, interval)
# is in the app's Settings page; values saved there take precedence.

# ---- Canvas (optional: can be set in Settings instead) ----
# Your institution's Canvas URL, e.g. https://canvas.instructure.com
CANVAS_BASE_URL=https://canvas.instructure.com
# Canvas → Account → Settings → Approved Integrations → + New Access Token
CANVAS_ACCESS_TOKEN=

# ---- App ----
APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./tcourses.db
# Where downloaded attachments are stored (relative to backend/ or absolute)
STORAGE_ROOT=../storage
CORS_ORIGINS=http://localhost:5173

# ---- Sync ----
# Initial auto-sync interval in minutes, measured from the end of the previous sync
SYNC_INTERVAL_MINUTES=15
# Run a full sync when the server starts
SYNC_ON_STARTUP=true
# Download course files locally (off: keep metadata only, download on demand)
AUTO_DOWNLOAD_FILES=false
# Per-file download limit (MB)
MAX_DOWNLOAD_MB=100
# Collect inline images from page/announcement bodies (banners, logos)
SYNC_INLINE_IMAGES=false
# Max number of page bodies fetched per course
MAX_PAGE_FETCH=500
# Minimum hours before a page body is re-fetched
PAGE_CACHE_HOURS=6
# Hard bound: anything not re-checked for this many days is re-checked first
MAX_RECHECK_DAYS=30
# Pages / files re-checked per course per sync round
PAGE_REFRESH_BATCH=10
FILE_RECHECK_BATCH=10
